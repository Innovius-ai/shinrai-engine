# shinrai-engine CPU image.
#
# No model is baked in: mount a bundle at /models or let the engine download
# from Hugging Face on first start (~1.3 GB for fp32 v1.1). To bake weights
# anyway, see Dockerfile.bundle.
#
# The onnxruntime/numpy/transformers pins are the exact versions the model
# bundles were exported and validated with — the transformers pin is
# contract-critical (tokenizer offset mapping IS the wire contract).

FROM python:3.12-slim

# Fixed uid so runAsUser/fsGroup in the Helm chart can reference it
# numerically; 10001 stays clear of uids base images pre-claim.
RUN useradd --create-home --uid 10001 srv

WORKDIR /app
COPY pyproject.toml README.md LICENSE NOTICE /app/
COPY src /app/src

RUN pip install --no-cache-dir ".[cpu]" && pip cache purge || true

ENV PYTHONUNBUFFERED=1 \
    SHINRAI_MODEL_CACHE=/models \
    HF_HUB_DISABLE_TELEMETRY=1

RUN mkdir -p /models && chown srv:srv /models
VOLUME /models

USER srv
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=4).status==200 else 1)"]

CMD ["python", "-m", "shinrai_engine"]
